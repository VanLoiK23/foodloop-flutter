rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép người dùng đã xác thực (bao gồm cả tài khoản ẩn danh Anonymous Auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated();
      match /{allChildren=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    match /reports/{reportId} {
      allow read, write: if isAuthenticated();
    }

    match /appeals/{appealId} {
      allow read, write: if isAuthenticated();
    }

    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }

    match /spaces/{spaceId} {
      allow read, write: if isAuthenticated();
    }

    match /members/{memberId} {
      allow read, write: if isAuthenticated();
    }

    match /invitations/{invitationId} {
      allow read, write: if isAuthenticated();
    }

    match /activities/{activityId} {
      allow read, write: if isAuthenticated();
    }

    match /rescue_orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    match /rescue_baskets/{basketId} {
      allow read, write: if isAuthenticated();
    }

    match /fridge_items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    match /food_posts/{postId} {
      allow read, write: if isAuthenticated();
    }

    match /food_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
